# ---- Server ----
PORT=5000
NODE_ENV=production
# Public URL of this API (used for local-disk file URLs when Cloudinary is not configured)
SERVER_URL=http://localhost:5000
# Frontend origin(s), comma separated
CLIENT_URL=http://localhost:5173

# ---- Database ----
MONGO_URI=mongodb://127.0.0.1:27017/assignment_bridge

# ---- Auth ----
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES=7d

# ---- Pricing (in rupees) ----
TASK_PRICE=100
WORKER_EARNING=50
MAX_ACTIVE_TASKS_PER_WORKER=5
MAX_REVISIONS=3
MIN_PAYOUT=50

# ---- Razorpay (https://dashboard.razorpay.com/app/keys) ----
# Leave empty to run in DEMO payment mode (development only)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Cloudinary (https://console.cloudinary.com) ----
# Leave empty to store files on local disk in server/uploads (development only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Seeded admin account (npm run seed) ----
ADMIN_NAME=Platform Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345
